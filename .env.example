# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y completa los valores.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# ---------------------------------------------------------------------------

# Secreto para firmar las cookies de sesión.
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-secreto-aleatorio-de-32-bytes

# Cadena de conexión a PostgreSQL (Supabase o local).
#
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Usa SIEMPRE el "Session pooler" (puerto 5432) o el "Transaction pooler" (6543):
#
#   postgresql://postgres.PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#   postgresql://postgres.PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# (también se acepta el prefijo antiguo `postgres://`)
DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Poner en 1 cuando sirvas la app por HTTPS (producción).
SESSION_COOKIE_SECURE=0

# 1 para activar el modo depuración de Flask. Nunca en producción.
FLASK_DEBUG=0